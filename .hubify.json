{
  "name": "hermes-agent",
  "description": "Hermes Agent (davidattaie fork): gateway, API server and web dashboard on Binar (webhook listener :8644 shares the gateway unit)",
  "kind": "service",
  "components": [
    {
      "name": "dashboard",
      "port": 9119,
      "unit": "hermes-dashboard.service",
      "health": "/api/status",
      "role": "web"
    },
    {
      "name": "api-server",
      "port": 8642,
      "unit": "hermes-gateway.service",
      "health": "/health",
      "role": "api"
    }
  ],
  "remote": "fork"
}
